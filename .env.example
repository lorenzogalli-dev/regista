# Copy to .env and fill in. Never commit .env.

# PostgreSQL (local Docker default shown; Azure Database for PostgreSQL in the cloud)
DATABASE_URL=postgresql://gtf:gtf@localhost:5432/gtf

# Model provider for the agents: fake (scripted, offline, free) | openai (any OpenAI-compatible
# endpoint: OPENAI_BASE_URL, OPENAI_API_KEY) | foundry. Switching is an env change only.
MODEL_PROVIDER=fake

# Microsoft Foundry (authentication: `az login`, no keys here)
FOUNDRY_PROJECT_ENDPOINT=
# Analyst (deployment name), with low reasoning effort
FOUNDRY_MODEL_REASONING=
FOUNDRY_REASONING_EFFORT=low
# Detector / Verifier / Narrator / Persona / Director (deployment name)
FOUNDRY_MODEL_FAST=

# Cost control: a run stops calling models once its spend reaches this (EUR, estimated from
# token usage and the prices below; set them from the official price page before a run).
RUN_BUDGET_EUR=1.0
PRICE_FAST_IN_EUR_PER_M=
PRICE_FAST_OUT_EUR_PER_M=
PRICE_REASONING_IN_EUR_PER_M=
PRICE_REASONING_OUT_EUR_PER_M=
AGENT_TIMEOUT_S=45
ANALYST_MAX_TOOL_CALLS=2

# Live mode: maximum model calls per UTC day before live sessions are refused
LIVE_DAILY_MODEL_CALL_CAP=2000

# Application Insights (OpenTelemetry exporter)
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Hidden storylines. Read only by the simulator and the eval harness, never by agents or the API.
GROUND_TRUTH_DIR=data/ground_truth

# Directory with generated public match files (events, tracking). Never the ground truth.
MATCH_DATA_DIR=data/generated

# Hosts allowed to call the MCP tools endpoint /mcp/ (comma-separated, DNS-rebinding protection)
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*
